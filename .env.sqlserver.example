# Copy these lines into .env, replacing the placeholder password.
# This project supports MySQL and SQL Server; DB_DIALECT selects one.
PORT=3000
SESSION_SECRET=replace-with-a-long-random-value

DB_DIALECT=mssql
DB_HOST=localhost
DB_INSTANCE=SQLEXPRESS
# With DB_INSTANCE set, leave DB_PORT blank. Do not use port 3307 (that is MySQL).
DB_PORT=
DB_NAME=warehouses_db
DB_USER=ecommerce_app
DB_PASS=CHON_MAT_KHAU_MANH_CUA_BAN
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
